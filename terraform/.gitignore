# Terraform working directory and provider plugins
.terraform/

# Terraform state and backups (may contain sensitive data)
*.tfstate
*.tfstate.*
terraform.tfstate
terraform.tfstate.*

# Terraform crash logs
crash.log
crash.*.log

# Saved plans
*.tfplan
*.plan

# Variable files may contain secrets
*.tfvars
*.tfvars.json
!*.tfvars.example

# CLI configuration and override files
.terraformrc
terraform.rc
override.tf
override.tf.json
*_override.tf
*_override.tf.json
